# EditorConfig: https://editorconfig.org
# Editor-level formatting that must agree with rustfmt.toml and .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust uses 4 spaces (rustfmt `tab_spaces`).
[*.rs]
indent_size = 4

# Data / config formats use 4 spaces, matching `rustfmt.toml` `tab_spaces` and
# the existing TOML files in this repository.
[*.{toml,json,yml,yaml}]
indent_size = 4

# JavaScript / TypeScript tooling, if ever added.
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Markdown: 2-space indents, and do not strip the trailing spaces that mark a
# hard line break.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require tabs.
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
