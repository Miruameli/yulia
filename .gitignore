# --- secrets / credentials --------------------------------------------------
# Never commit these. `git add -A` must not silently stage a secret.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_ed25519
.netrc
.npmrc
.cargo/credentials*
secrets.*
credentials.json
*.service-account.json
