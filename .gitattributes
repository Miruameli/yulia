# Normalize line endings: the repository stores LF and checks out LF everywhere.
* text=auto eol=lf

# Source
*.rs    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf

# Scripts / config
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Documentation
*.md    text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
